# HQ Desk configuration. Copy this file to .env and fill it in.
# .env is git-ignored. Never commit it and never paste the key into chat.

# Google Places API (New) key. Leave blank to run without Google search.
# Restrict it to "Places API (New)" only - see README.
GOOGLE_PLACES_API_KEY=

# Port for the local server. The server always binds to 127.0.0.1 only.
PORT=4317

# Server-side caps on Google calls (search + details combined).
GOOGLE_RATE_LIMIT_PER_MINUTE=10
GOOGLE_RATE_LIMIT_PER_DAY=200

# In-memory cache for live place details, in seconds. 0 = no cache.
# Hard maximum is 299 (under 5 minutes). Nothing is ever cached to disk.
PLACE_DETAILS_CACHE_SECONDS=0

# SQLite database file (your own data only).
DB_PATH=./data/hq-desk.db

# Optional: language/region hints sent to Google.
GOOGLE_LANGUAGE_CODE=en
GOOGLE_REGION_CODE=US

# ---------------------------------------------------------------------------
# Deep Research (optional). Reads an agency's OWN public website (pages you
# confirm) and asks an AI model for a fit assessment with quoted sources.
# Leave LLM_API_KEY blank to keep it off; everything else still works.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
# Default model. claude-sonnet-5-5 is about half the price; claude-haiku-4-5 is cheaper still.
LLM_MODEL=claude-opus-5-5
# Anthropic API key (console.anthropic.com). Only read from this file.
LLM_API_KEY=
# low | medium | high. Higher = more thorough and more output tokens.
LLM_EFFORT=medium
# Re-run on a fallback model if the primary declines (Anthropic server-side fallback).
LLM_REFUSAL_FALLBACK=true
# Only needed for a model not in src/research/cost.js (USD per million tokens).
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# Required for research: put in the crawler's User-Agent so site owners can reach you.
RESEARCH_CONTACT_EMAIL=

# Cost and safety caps
RESEARCH_MAX_PAGES=8
RESEARCH_MAX_INPUT_TOKENS=30000
RESEARCH_MAX_OUTPUT_TOKENS=16000
RESEARCH_RUNS_PER_DAY=10
RESEARCH_DAILY_SPEND_CAP_USD=3.00

# Where the "Verify licence" button goes. Set this to the PA Insurance
# Department's current producer/licensee lookup page (check the URL yourself).
PA_LICENCE_LOOKUP_URL=https://www.insurance.pa.gov/
